<script>

/* ==========================================
PRODUCT DATA
========================================== */

const products = [

{
name:"AI Lipsync",
old:"₹800",
price:"₹500",
image:"https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?auto=format&fit=crop&w=700&q=80"
},

{
name:"Heaven Video",
old:"₹5000",
price:"₹3000",
image:"https://images.unsplash.com/photo-1530103862676-de8c9debad1d?auto=format&fit=crop&w=700&q=80"
},

{
name:"AR Frame",
old:"₹499",
price:"₹299",
image:"https://images.unsplash.com/photo-1513519245088-0e12902e5a38?auto=format&fit=crop&w=700&q=80"
},

{
name:"Animation Video",
old:"₹3800",
price:"₹3000",
image:"https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?auto=format&fit=crop&w=700&q=80"
},

{
name:"Photo to AI Video",
old:"₹1800",
price:"₹1200",
image:"https://images.unsplash.com/photo-1522673607200-164d1b6ce486?auto=format&fit=crop&w=700&q=80"
},

{
name:"AI PhotoShoot",
old:"₹1000",
price:"₹500",
image:"https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=700&q=80"
},

{
name:"Get a Song",
old:"₹1000",
price:"₹500",
image:"https://images.unsplash.com/photo-1506157786151-b8491531f063?auto=format&fit=crop&w=700&q=80"
},

{
name:"Digital Art",
old:"₹1500",
price:"₹1000",
image:"https://images.unsplash.com/photo-1561214115-f2f134cc4912?auto=format&fit=crop&w=700&q=80"
},

{
name:"Digital Merge",
old:"₹1500",
price:"₹1000",
image:"https://images.unsplash.com/photo-1513364776144-60967b0f800f?auto=format&fit=crop&w=700&q=80"
},

{
name:"E-Invitation",
old:"₹500",
price:"₹250",
image:"https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=700&q=80"
},

{
name:"Acrylic Frame",
old:"₹800",
price:"₹549",
image:"https://images.unsplash.com/photo-1544816155-12df9643f363?auto=format&fit=crop&w=700&q=80"
}

];


/* ==========================================
ELEMENTS
========================================== */

const productGrid =
document.getElementById("productGrid");

const productSelect =
document.getElementById("productSelect");

const orderModal =
document.getElementById("orderModal");

const navLinks =
document.getElementById("navLinks");


/* ==========================================
CREATE PRODUCT CARDS
========================================== */

products.forEach((product,index)=>{

const card = document.createElement("div");

card.className = "product-card";


card.innerHTML = `

<div class="product-image">

<img
src="${product.image}"
alt="${product.name}"
loading="lazy">

</div>

<div class="product-info">

<h3>
${product.name}
</h3>

<div class="price">

<span class="old-price">
${product.old}
</span>

<span class="new-price">
${product.price}
</span>

</div>

<button
class="buy-btn"
data-index="${index}">

Create / Order

</button>

</div>

`;


productGrid.appendChild(card);


/* ADD TO SELECT */

const option =
document.createElement("option");

option.value = product.name;

option.textContent =
`${product.name} - ${product.price}`;

productSelect.appendChild(option);

});


/* ==========================================
OPEN MODAL
========================================== */

function openModal(productName=""){

orderModal.classList.add("show");

document.body.style.overflow="hidden";

if(productName){

productSelect.value =
productName;

}

}


/* ==========================================
CLOSE MODAL
========================================== */

function closeModal(){

orderModal.classList.remove("show");

document.body.style.overflow="";

}


/* ==========================================
ALL CREATE BUTTONS
========================================== */

document.getElementById("navCreateBtn")
.addEventListener("click",()=>{

openModal();

});


document.getElementById("heroCreateBtn")
.addEventListener("click",()=>{

openModal();

});


document.getElementById("aboutBtn")
.addEventListener("click",()=>{

openModal();

});


/* ==========================================
PRODUCT BUTTONS
========================================== */

document.addEventListener("click",(event)=>{

if(event.target.classList.contains("buy-btn")){

const index =
event.target.dataset.index;

const product =
products[index];

openModal(product.name);

}

});


/* ==========================================
CLOSE MODAL
========================================== */

document.getElementById("closeModal")
.addEventListener("click",closeModal);


/* ==========================================
CLICK OUTSIDE MODAL
========================================== */

orderModal.addEventListener("click",(event)=>{

if(event.target === orderModal){

closeModal();

}

});


/* ==========================================
ESCAPE KEY
========================================== */

document.addEventListener("keydown",(event)=>{

if(event.key === "Escape"){

closeModal();

}

});


/* ==========================================
MOBILE MENU
========================================== */

document.getElementById("menu")
.addEventListener("click",()=>{

navLinks.classList.toggle("active");

});


/* ==========================================
CLOSE MOBILE MENU AFTER CLICK
========================================== */

document.querySelectorAll(".nav-links a")
.forEach(link=>{

link.addEventListener("click",()=>{

navLinks.classList.remove("active");

});

});


/* ==========================================
SAMPLE BUTTON
========================================== */

document.getElementById("sampleBtn")
.addEventListener("click",()=>{

document.getElementById("songs")
.scrollIntoView({

behavior:"smooth"

});

});


/* ==========================================
VISIT WEBSITE BUTTON
========================================== */

document.getElementById("visitBtn")
.addEventListener("click",()=>{

window.open(
"https://acustomsong.com/",
"_blank"
);

});


/* ==========================================
SONG PLAYER
========================================== */

let currentAudio = null;
let currentButton = null;


document.querySelectorAll(".play-btn")
.forEach(button=>{

button.addEventListener("click",()=>{

const audioUrl =
button.dataset.audio;


/* STOP CURRENT */

if(currentAudio){

currentAudio.pause();

}


/* SAME BUTTON */

if(currentButton === button){

button.textContent =
"▶ Play Sample";

currentAudio = null;
currentButton = null;

return;

}


/* CREATE AUDIO */

const audio =
new Audio(audioUrl);

audio.play()
.catch(()=>{

alert(
"Sample audio could not be played. Please check your internet connection."
);

});


button.textContent =
"❚❚ Playing...";


currentAudio = audio;
currentButton = button;


/* WHEN FINISHED */

audio.addEventListener("ended",()=>{

button.textContent =
"▶ Play Sample";

currentAudio = null;
currentButton = null;

});

});

});


/* ==========================================
FAQ
========================================== */

document.querySelectorAll(".faq-question")
.forEach(button=>{

button.addEventListener("click",()=>{

const item =
button.parentElement;

const isActive =
item.classList.contains("active");


document.querySelectorAll(".faq-item")
.forEach(other=>{

other.classList.remove("active");

const span =
other.querySelector(".faq-question span");

span.textContent="+";

});


if(!isActive){

item.classList.add("active");

button.querySelector("span")
.textContent="−";

}

});

});


/* ==========================================
FORM SUBMISSION
========================================== */

document.getElementById("orderForm")
.addEventListener("submit",(event)=>{

event.preventDefault();


const name =
document.getElementById("customerName").value.trim();

const email =
document.getElementById("customerEmail").value.trim();

const product =
document.getElementById("productSelect").value;

const message =
document.getElementById("customerMessage").value.trim();


if(!name || !email || !product || !message){

alert(
"Please fill all fields before submitting."
);

return;

}


/* SUCCESS */

const success =
document.getElementById("successMessage");

success.style.display="block";


/* RESET */

document.getElementById("orderForm")
.reset();


/* HIDE SUCCESS AFTER 4 SEC */

setTimeout(()=>{

success.style.display="none";

closeModal();

},4000);

});


/* ==========================================
IMAGE FALLBACK
========================================== */

document.addEventListener(
"error",
(event)=>{

if(event.target.tagName === "IMG"){

event.target.style.background =
"linear-gradient(135deg,#ead0d0,#f8e7e3)";

}

},
true
);

</script>

