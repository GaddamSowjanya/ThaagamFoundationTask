<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="A Custom Song - Personalized songs and meaningful gifts">
<title>A Custom Song | Personalized Gifts</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

<style>
:root{
  --purple:#9a25d7;
  --purple-dark:#7614aa;
  --pink:#d82bb9;
  --ink:#19131d;
  --muted:#716975;
  --soft:#fbf6ff;
  --line:#eadff0;
  --white:#fff;
  --shadow:0 14px 40px rgba(71,20,94,.10);
  --radius:20px;
  --container:1200px;
}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:"DM Sans",Arial,sans-serif;
  color:var(--ink);
  background:#fff;
  overflow-x:hidden;
}
img{max-width:100%;display:block}
a{text-decoration:none;color:inherit}
button{font:inherit}
.container{width:min(var(--container),calc(100% - 40px));margin:auto}
.section{padding:82px 0}
.section-tag{
  color:var(--purple);
  font-size:15px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:1.7px;
  text-align:center;
  margin-bottom:10px;
}
.section-title{
  font-family:"Playfair Display",Georgia,serif;
  font-size:42px;
  line-height:1.15;
  text-align:center;
  margin-bottom:15px;
}
.section-copy{
  max-width:760px;
  margin:0 auto;
  color:var(--muted);
  text-align:center;
  line-height:1.8;
}

/* Header */
.site-header{
  position:sticky;
  top:0;
  z-index:1000;
  background:rgba(255,255,255,.97);
  backdrop-filter:blur(12px);
  border-bottom:1px solid rgba(0,0,0,.05);
}
.nav{
  min-height:82px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:30px;
}
.brand img{width:205px;height:auto}
.nav-list{
  list-style:none;
  display:flex;
  align-items:center;
  gap:31px;
}
.nav-list a{
  font-size:14px;
  font-weight:600;
  color:#332d36;
  transition:.2s;
}
.nav-list a:hover{color:var(--purple)}
.nav-cta{
  color:#fff!important;
  background:linear-gradient(135deg,var(--purple),var(--pink));
  padding:12px 23px;
  border-radius:999px;
  box-shadow:0 8px 22px rgba(154,37,215,.22);
}
.menu{
  display:none;
  border:0;
  background:transparent;
  width:44px;
  height:44px;
  font-size:27px;
  cursor:pointer;
}

/* Hero */
.hero{
  background:#f1dfff;
  overflow:hidden;
}
.hero img{
  width:100%;
  height:auto;
  min-height:420px;
  max-height:730px;
  object-fit:cover;
  object-position:center;
}

/* Products */
.products{background:#fff}
.product-grid{
  margin-top:42px;
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:22px;
}
.product-card{
  background:#fff;
  border:1px solid var(--line);
  border-radius:var(--radius);
  overflow:hidden;
  box-shadow:0 7px 25px rgba(42,16,53,.06);
  transition:transform .25s,box-shadow .25s;
}
.product-card:hover{
  transform:translateY(-6px);
  box-shadow:var(--shadow);
}
.product-visual{
  height:190px;
  position:relative;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}
.product-visual::before{
  content:"";
  position:absolute;
  width:170px;height:170px;
  border-radius:50%;
  background:rgba(255,255,255,.24);
  top:-55px;right:-45px;
}
.product-visual::after{
  content:"";
  position:absolute;
  width:120px;height:120px;
  border-radius:50%;
  background:rgba(255,255,255,.18);
  bottom:-55px;left:-35px;
}
.visual-icon{
  position:relative;
  z-index:1;
  width:76px;height:76px;
  border-radius:24px;
  background:rgba(255,255,255,.92);
  display:grid;
  place-items:center;
  font-size:34px;
  box-shadow:0 12px 28px rgba(80,20,100,.12);
}
.v1{background:linear-gradient(135deg,#f9b8e9,#b88cff)}
.v2{background:linear-gradient(135deg,#d8b4ff,#ffb8cf)}
.v3{background:linear-gradient(135deg,#a6d9ff,#d6a9ff)}
.v4{background:linear-gradient(135deg,#ffc0df,#b9a7ff)}
.v5{background:linear-gradient(135deg,#b6f0e1,#c9b0ff)}
.v6{background:linear-gradient(135deg,#ffe0a9,#f8b1dc)}
.v7{background:linear-gradient(135deg,#c6b6ff,#f7b1d6)}
.v8{background:linear-gradient(135deg,#d7c2ff,#a9e6ff)}
.v9{background:linear-gradient(135deg,#ffbfd2,#d6b5ff)}
.v10{background:linear-gradient(135deg,#ffe2ad,#f8b5e4)}
.v11{background:linear-gradient(135deg,#b8e7ff,#d8b2ff)}

.product-body{padding:19px 19px 21px}
.product-body h3{
  font-size:17px;
  line-height:1.35;
  min-height:47px;
}
.price{
  margin-top:11px;
  display:flex;
  align-items:center;
  gap:9px;
}
.old{color:#a9a2aa;text-decoration:line-through;font-size:14px}
.new{color:var(--purple);font-size:20px;font-weight:800}
.product-btn{
  display:block;
  margin-top:16px;
  text-align:center;
  background:#24112c;
  color:#fff;
  border-radius:10px;
  padding:11px 13px;
  font-size:14px;
  font-weight:700;
  transition:.2s;
}
.product-btn:hover{background:var(--purple)}

/* Love story */
.love{background:var(--soft)}
.story-grid{
  margin-top:40px;
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:18px;
}
.story-card{
  position:relative;
  overflow:hidden;
  border-radius:18px;
  background:#eee;
  aspect-ratio:4/4.6;
}
.story-card img{
  width:100%;
  height:100%;
  object-fit:cover;
  transition:transform .45s;
}
.story-card:hover img{transform:scale(1.06)}
.story-card:after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(transparent 60%,rgba(0,0,0,.20));
  pointer-events:none;
}

/* Songs */
.song-wrap{margin-top:42px;position:relative}
.song-track{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:18px;
}
.song-card{
  min-width:0;
  padding:12px;
  border:1px solid var(--line);
  background:#fff;
  border-radius:18px;
  box-shadow:0 8px 24px rgba(45,17,57,.06);
}
.song-card img{
  width:100%;
  aspect-ratio:1;
  object-fit:cover;
  border-radius:13px;
}
.song-card h3{
  font-size:16px;
  margin:13px 4px 9px;
}
.song-card audio{
  width:100%;
  height:34px;
}
.song-note{
  margin-top:15px;
  text-align:center;
  font-size:12px;
  color:#9b939f;
}

/* About */
.about{
  background:#fff;
}
.about-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  align-items:center;
  gap:65px;
}
.about-image{
  border-radius:25px;
  overflow:hidden;
  box-shadow:var(--shadow);
}
.about-image img{width:100%}
.about-copy .section-tag{text-align:left}
.about-copy h2{
  font-family:"Playfair Display",Georgia,serif;
  font-size:42px;
  line-height:1.15;
  margin-bottom:20px;
}
.about-copy h3{
  font-family:"Playfair Display",Georgia,serif;
  font-size:25px;
  margin:26px 0 10px;
}
.about-copy p{
  color:var(--muted);
  line-height:1.85;
}
.more-btn{
  display:inline-flex;
  margin-top:24px;
  background:linear-gradient(135deg,var(--purple),var(--pink));
  color:#fff;
  padding:13px 24px;
  border-radius:999px;
  font-weight:700;
}

/* QR */
.qr{
  background:linear-gradient(135deg,#f8efff,#fff);
}
.qr-grid{
  display:grid;
  grid-template-columns:.9fr 1.1fr;
  align-items:center;
  gap:70px;
}
.qr-image{text-align:center}
.qr-image img{
  width:min(520px,100%);
  margin:auto;
}
.qr-copy .section-tag{text-align:left}
.qr-copy h2{
  font-family:"Playfair Display",Georgia,serif;
  font-size:42px;
  margin-bottom:10px;
}
.qr-copy h3{font-size:23px;margin-bottom:12px}
.qr-copy p{color:var(--muted);line-height:1.8;max-width:520px}

/* Testimonials */
.testimonials{background:#fff}
.testimonial-grid{
  margin-top:42px;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}
.testimonial{
  border:1px solid var(--line);
  border-radius:19px;
  padding:25px;
  box-shadow:0 8px 25px rgba(44,15,55,.05);
  background:#fff;
}
.client-head{
  display:flex;
  align-items:center;
  gap:14px;
}
.client-head img{
  width:58px;height:58px;border-radius:50%;object-fit:cover;
}
.client-head h3{font-size:16px}
.stars{color:#f5ad00;letter-spacing:2px;margin-top:4px}
.score{font-size:12px;color:#89818b;margin-top:2px}
.testimonial p{
  margin-top:17px;
  color:#655e68;
  line-height:1.75;
  font-size:14px;
}

/* FAQ */
.faq-section{background:var(--soft)}
.faq{
  max-width:900px;
  margin:40px auto 0;
}
.faq-item{
  background:#fff;
  border:1px solid var(--line);
  border-radius:13px;
  margin-bottom:12px;
  overflow:hidden;
}
.faq-q{
  width:100%;
  border:0;
  background:#fff;
  padding:20px 22px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  text-align:left;
  font-weight:700;
  color:#251d29;
  cursor:pointer;
}
.faq-q span{
  width:28px;height:28px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:#f3e2fb;
  color:var(--purple);
  font-size:20px;
  flex:0 0 auto;
}
.faq-a{
  max-height:0;
  overflow:hidden;
  transition:max-height .3s ease;
}
.faq-a p{
  color:var(--muted);
  line-height:1.75;
  padding:0 22px 20px;
}

/* Footer */
.footer{
  background:#19121d;
  color:#fff;
  padding:60px 0 25px;
}
.footer-grid{
  display:grid;
  grid-template-columns:1fr 1fr 1.25fr;
  gap:60px;
}
.footer h3{font-size:17px;margin-bottom:20px}
.footer ul{list-style:none}
.footer li{margin-bottom:12px}
.footer li,.footer p{color:#cfc7d2;font-size:14px;line-height:1.8}
.footer a:hover{color:#d86fff}
.footer-bottom{
  margin-top:42px;
  padding-top:20px;
  border-top:1px solid #3a303e;
  text-align:center;
  color:#938995;
  font-size:13px;
}

/* Floating action */
.whatsapp{
  position:fixed;
  right:20px;
  bottom:20px;
  width:56px;height:56px;
  border-radius:50%;
  background:#25d366;
  color:#fff;
  display:grid;
  place-items:center;
  z-index:900;
  font-size:27px;
  box-shadow:0 8px 25px rgba(0,0,0,.2);
}

/* Lightbox */
.lightbox{
  position:fixed;
  inset:0;
  background:rgba(15,8,18,.9);
  display:none;
  place-items:center;
  z-index:2000;
  padding:25px;
}
.lightbox.open{display:grid}
.lightbox img{
  max-width:min(900px,95vw);
  max-height:90vh;
  object-fit:contain;
  border-radius:12px;
}
.lightbox-close{
  position:absolute;
  top:18px;
  right:24px;
  border:0;
  background:none;
  color:#fff;
  font-size:40px;
  cursor:pointer;
}

/* Responsive */
@media(max-width:1100px){
  .nav-list{gap:19px}
  .product-grid{grid-template-columns:repeat(3,1fr)}
  .song-track{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:800px){
  .container{width:min(100% - 28px,var(--container))}
  .section{padding:62px 0}
  .section-title{font-size:33px}
  .brand img{width:170px}
  .menu{display:block}
  .nav{min-height:70px}
  .nav-list{
    display:none;
    position:absolute;
    top:70px;
    left:0;
    right:0;
    background:#fff;
    flex-direction:column;
    align-items:stretch;
    gap:0;
    padding:8px 18px 20px;
    border-bottom:1px solid var(--line);
    box-shadow:0 15px 25px rgba(0,0,0,.08);
  }
  .nav-list.open{display:flex}
  .nav-list li{border-bottom:1px solid #f0e9f2}
  .nav-list li:last-child{border:0}
  .nav-list a{display:block;padding:14px 4px}
  .nav-cta{text-align:center!important;margin-top:8px}
  .hero img{min-height:0}
  .product-grid{grid-template-columns:repeat(2,1fr);gap:14px}
  .product-visual{height:165px}
  .story-grid{grid-template-columns:repeat(2,1fr);gap:12px}
  .song-track{
    display:flex;
    overflow-x:auto;
    scroll-snap-type:x mandatory;
    scrollbar-width:none;
    padding-bottom:6px;
  }
  .song-track::-webkit-scrollbar{display:none}
  .song-card{
    flex:0 0 70%;
    scroll-snap-align:start;
  }
  .about-grid,.qr-grid{grid-template-columns:1fr;gap:35px}
  .about-copy .section-tag,.qr-copy .section-tag{text-align:center}
  .about-copy h2,.qr-copy h2{text-align:center;font-size:34px}
  .qr-copy{text-align:center}
  .qr-copy p{margin:auto}
  .testimonial-grid{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:1fr;gap:30px}
}
@media(max-width:430px){
  .section{padding:52px 0}
  .section-title{font-size:29px}
  .section-copy{font-size:14px}
  .product-grid{grid-template-columns:1fr}
  .product-visual{height:190px}
  .story-grid{grid-template-columns:1fr 1fr}
  .story-card{border-radius:13px}
  .song-card{flex-basis:82%}
  .about-copy h2,.qr-copy h2{font-size:30px}
  .qr-copy h3{font-size:20px}
  .whatsapp{width:50px;height:50px;right:14px;bottom:14px}
}
</style>
</head>

